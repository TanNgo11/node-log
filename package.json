{
  "name": "@tanngo11/log",
  "version": "0.4.6",
  "description": "Structured JSON logging for Node services, implementing log contract v1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanNgo11/node-log.git"
  },
  "homepage": "https://github.com/TanNgo11/node-log#readme",
  "bugs": {
    "url": "https://github.com/TanNgo11/node-log/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRACT.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      },
      "require": {
        "types": "./dist/nest.d.cts",
        "default": "./dist/nest.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./next/edge": {
      "import": {
        "types": "./dist/next-edge.d.ts",
        "default": "./dist/next-edge.js"
      },
      "require": {
        "types": "./dist/next-edge.d.cts",
        "default": "./dist/next-edge.cjs"
      }
    },
    "./bullmq": {
      "import": {
        "types": "./dist/bullmq.d.ts",
        "default": "./dist/bullmq.js"
      },
      "require": {
        "types": "./dist/bullmq.d.cts",
        "default": "./dist/bullmq.cjs"
      }
    },
    "./prisma": {
      "import": {
        "types": "./dist/prisma.d.ts",
        "default": "./dist/prisma.js"
      },
      "require": {
        "types": "./dist/prisma.d.cts",
        "default": "./dist/prisma.cjs"
      }
    },
    "./strapi": {
      "import": {
        "types": "./dist/strapi.d.ts",
        "default": "./dist/strapi.js"
      },
      "require": {
        "types": "./dist/strapi.d.cts",
        "default": "./dist/strapi.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@koa/router": "^12.0.2",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-fastify": "^10.4.22",
    "@prisma/client": "^6.19.3",
    "@types/express": "^4.17.25",
    "@types/koa": "^2.15.2",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^22.20.4",
    "express": "^4.22.3",
    "fastify": "^5.12.5",
    "koa": "^2.16.4",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "winston": "^3.10.0"
  },
  "typesVersions": {
    "*": {
      "express": [
        "./dist/express.d.ts"
      ],
      "fastify": [
        "./dist/fastify.d.ts"
      ],
      "nest": [
        "./dist/nest.d.ts"
      ],
      "next": [
        "./dist/next.d.ts"
      ],
      "next/edge": [
        "./dist/next-edge.d.ts"
      ],
      "bullmq": [
        "./dist/bullmq.d.ts"
      ],
      "prisma": [
        "./dist/prisma.d.ts"
      ],
      "strapi": [
        "./dist/strapi.d.ts"
      ]
    }
  }
}
