{
  "name": "@tanngo11/log",
  "version": "0.1.0",
  "description": "Structured JSON logging for Node services, implementing log contract v1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanNgo11/node-log.git"
  },
  "homepage": "https://github.com/TanNgo11/node-log#readme",
  "bugs": {
    "url": "https://github.com/TanNgo11/node-log/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRACT.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      },
      "require": {
        "types": "./dist/nest.d.cts",
        "default": "./dist/nest.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./next/edge": {
      "import": {
        "types": "./dist/next-edge.d.ts",
        "default": "./dist/next-edge.js"
      },
      "require": {
        "types": "./dist/next-edge.d.cts",
        "default": "./dist/next-edge.cjs"
      }
    },
    "./bullmq": {
      "import": {
        "types": "./dist/bullmq.d.ts",
        "default": "./dist/bullmq.js"
      },
      "require": {
        "types": "./dist/bullmq.d.cts",
        "default": "./dist/bullmq.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "express": "^4.22.3",
    "fastify": "^5.12.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
